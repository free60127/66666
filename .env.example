# 回译训练工作室 · 后端 AI 配置（复制为 .env 后填写）
# 任何 OpenAI 兼容接口都可以：DeepSeek / OpenAI / 通义 / GLM / Volcano / Ollama ...
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 拍照 / 图片识别（OCR）专用的视觉模型：必须支持图片输入，否则识别会失败
# 留空则沿用上面的 AI_MODEL（此时 AI_MODEL 也必须是多模态模型）
AI_VISION_MODEL=deepseek-v4-flash-vision-exp
# 视觉模型也可以用不同的接口 / Key（一般留空，与上面相同即可）
# AI_VISION_BASE_URL=https://api.deepseek.com/v1
# AI_VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 单次生成允许的最大输出 token（默认 20000；输出被截断时后端会自动用更大上限重试）
AI_MAX_TOKENS=20000
# 本地服务端口
PORT=8787
