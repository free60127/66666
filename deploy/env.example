# 回译本服务器环境变量模板 → 上传到服务器后改名为 /var/www/bts/.env 并填入真实值
# （值和 Render 控制台里配的 Environment 一致，迁移后云同步/账号数据无缝衔接）

PORT=8787
HOST=127.0.0.1
TRUST_PROXY_HOPS=1
FREE_DAILY_ACCOUNT=3
FREE_DAILY_IP=2
DAILY_SERVER_BUDGET=300
CLASS_KEY_DAILY=300
EMAIL_VERIFY=1

# Upstash KV（必填）：云同步、账号、批改任务持久化
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 注册验证码/账号找回邮件（EMAIL_VERIFY=1 时必填，不填无法注册）
SMTP_USER=
SMTP_PASS=

# ---- 公共额度闸门（成本护栏）----
# 站点 Key 代跑的每日免费额度：登录账号 / 未登录访客（按 IP）
# FREE_DAILY_ACCOUNT=3
# FREE_DAILY_IP=2
# ---- 全网熔断：站点 Key 每日总上限，超了全网暂停次日恢复 ----
# DAILY_SERVER_BUDGET=300
# ---- 班级统一 Key 每班每日额度（教师自己的 Key，不占上面全网预算）----
# CLASS_KEY_DAILY=300
# ---- 注册邮箱验证开关（默认开；自托管未配 SMTP 时设 0 关闭）----
# EMAIL_VERIFY=1