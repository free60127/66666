# 回译本服务器环境变量模板 → 上传到服务器后改名为 /var/www/bts/.env 并填入真实值
# （值和 Render 控制台里配的 Environment 一致，迁移后云同步/账号数据无缝衔接）

PORT=8787
HOST=127.0.0.1
TRUST_PROXY_HOPS=1
FREE_DAILY_ACCOUNT=3
FREE_DAILY_IP=2
DAILY_SERVER_BUDGET=300
CLASS_KEY_DAILY=300

# Upstash KV（必填）：云同步、账号、批改任务持久化
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 注册验证码/账号找回邮件（公共部署默认要求邮箱验证，不填无法注册）
SMTP_USER=
SMTP_PASS=
